{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Tarafagat/asterion-plugin-contract/schema/apc-v1.schema.json",
  "title": "Asterion Plugin Contract v1 — plugin.yaml",
  "description": "Espejo, mantenido a mano, de los structs Go en apc/manifest.go. Para tooling no-Go que necesite validar un plugin.yaml sin depender del binario de Asterion. La fuente de verdad del comportamiento sigue siendo apc/manifest.go — si ambos alguna vez divergen, el código Go manda.",
  "type": "object",
  "required": ["name", "version", "start", "port"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "repo": { "type": "string" },
    "contract_version": { "type": "string", "enum": ["asterion.plugin/v1"] },
    "language": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "start": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "port": { "type": "integer", "minimum": 0 },
    "health_path": { "type": "string" },
    "config_schema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "number", "bool"] },
          "secret": { "type": "boolean" },
          "required": { "type": "boolean" },
          "default": { "type": "string" }
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "base_path": { "type": "string" },
        "openapi": { "type": "string" }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "network": { "type": "array", "items": { "type": "string" } },
        "filesystem": { "type": "array", "items": { "type": "string" } },
        "database": { "type": "boolean" },
        "secrets": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "endpoint"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "minLength": 1 },
          "schema": { "type": "string" },
          "primary_key": { "type": "string" },
          "crud": {
            "type": "array",
            "items": { "enum": ["create", "read", "update", "delete", "list"] }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "method", "endpoint"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "endpoint": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "publishes": { "type": "array", "items": { "type": "string" } },
        "subscribes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
