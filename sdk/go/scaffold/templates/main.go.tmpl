package main

import (
	"encoding/json"
	"log"
	"net/http"
	"strconv"
	"sync"

	"github.com/Tarafagat/asterion-plugin-contract/sdk/go/pdk"
)

// {{.Name}} — generado por `asterion plugin init`. Este archivo ya cumple
// el Asterion Plugin Contract (health check + el resource/action que
// declara plugin.yaml) — reemplazá la lógica de items por la de tu plugin.
func main() {
	logger := pdk.NewLogger(pdk.Name())
	port := pdk.Port()
	if port == "" {
		port = "8080" // corriendo fuera de Asterion, ej. para probar a mano
	}

	store := &itemStore{items: map[string]any{}}

	mux := http.NewServeMux()
	mux.HandleFunc("GET /health", pdk.SimpleHealthHandler())
	mux.HandleFunc("GET /api/v1/ping", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(w, map[string]string{"pong": "true"})
	})
	mux.HandleFunc("GET /api/v1/items", func(w http.ResponseWriter, r *http.Request) {
		writeJSON(w, store.list())
	})
	mux.HandleFunc("POST /api/v1/items", func(w http.ResponseWriter, r *http.Request) {
		var item map[string]any
		if err := json.NewDecoder(r.Body).Decode(&item); err != nil {
			pdk.WriteError(w, http.StatusBadRequest, "cuerpo inválido", err.Error())
			return
		}
		writeJSON(w, store.create(item))
	})

	logger.Info("arrancando", map[string]any{"port": port})
	if err := http.ListenAndServe("127.0.0.1:"+port, mux); err != nil {
		log.Fatal(err)
	}
}

func writeJSON(w http.ResponseWriter, v any) {
	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(v)
}

type itemStore struct {
	mu    sync.Mutex
	items map[string]any
	next  int
}

func (s *itemStore) list() []any {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := make([]any, 0, len(s.items))
	for _, v := range s.items {
		out = append(out, v)
	}
	return out
}

func (s *itemStore) create(item map[string]any) map[string]any {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.next++
	id := s.next
	item["id"] = id
	s.items[strconv.Itoa(id)] = item
	return item
}
